{#
    Template: 404 (sample theme)
    ============================
    Use with content/404.md (template: 404). Every URL is built from
    site_base_url, so the site must set SITE_BASE_URL (including any sub-path).
    The sample theme ships no search, so this page has no search block.

    Links come from `404_links` in siteconfig.yaml (list of {title, url}),
    else menu.top (title: url map), else the home link.
#}
{% extends 'base.html.twig' %}

{% block header %}
<p><a href="{{ site_base_url }}">{{ site_name | default('StaticForge') }}</a></p>
{% endblock %}

{% block navigation %}{% endblock %}

{% block content %}
    {% set custom_links = _context['404_links'] ?? null %}
    {% set raw_links = [] %}
    {% if custom_links is iterable and custom_links|length > 0 %}
        {% for item in custom_links %}
            {% if item.title is defined and item.url is defined %}
                {% set raw_links = raw_links|merge([{title: item.title, url: item.url}]) %}
            {% endif %}
        {% endfor %}
    {% elseif menu.top is defined and menu.top is iterable %}
        {% for item_title, item_url in menu.top %}
            {% set raw_links = raw_links|merge([{title: item_title, url: item_url}]) %}
        {% endfor %}
    {% endif %}
    {% if raw_links|length == 0 %}
        {% set raw_links = [{title: 'Home', url: ''}] %}
    {% endif %}

    <p class="meta">404</p>
    <h1>Page not found</h1>
    <p>The page you asked for does not exist or has moved.</p>
    <p><a href="{{ site_base_url }}"><strong>Go to the homepage</strong></a></p>

    <nav aria-label="Helpful links">
        <h2>Popular sections</h2>
        <ul>
        {% for link in raw_links %}
            {% set link_url = link.url|default('')|trim %}
            {% if link_url matches '~^https?://~i' %}
            <li><a href="{{ link_url }}">{{ link.title }}</a></li>
            {% else %}
            <li><a href="{{ site_base_url }}{{ link_url|trim('/', 'left') }}">{{ link.title }}</a></li>
            {% endif %}
        {% endfor %}
        </ul>
    </nav>
    <p><a href="{{ site_base_url }}sitemap.xml">Sitemap</a></p>
{% endblock %}
