# StaticForge Environment Configuration

# Site Information
SITE_BASE_URL="http://localhost:8000/"
UPLOAD_URL="https://example.com"

# Directory Paths (relative to project root)
SOURCE_DIR="content"
OUTPUT_DIR="public"
TEMPLATE_DIR="templates"
FEATURES_DIR="src/Features"

# Optional Configuration
LOG_LEVEL="INFO"
LOG_FILE="logs/staticforge.log"

# SFTP Upload Configuration
# Remote server hostname or IP address (required for site:upload)
SFTP_HOST="example.com"
# SFTP port (default: 22)
SFTP_PORT=22
# Username for authentication (required)
SFTP_USERNAME="your-username"
# Password authentication (optional - use password OR private key, not both)
SFTP_PASSWORD="your-password"
# Private key authentication (optional - recommended over password)
# Path to SSH private key file (e.g., /home/user/.ssh/id_rsa)
SFTP_PRIVATE_KEY_PATH=""
# Passphrase for encrypted private key (optional)
SFTP_PRIVATE_KEY_PASSPHRASE=""
# Remote directory path to upload site to (required, e.g., /var/www/html)
SFTP_REMOTE_PATH="/var/www/html"
# Optional: pin the exact expected host key instead of trust-on-first-use.
# Format matches what the server presents, e.g. "ssh-ed25519 AAAAC3NzaC1...".
# Leave unset to trust the key on first connect and verify it on every
# connection after that, refusing if it ever changes.
SFTP_HOST_KEY=""

GOOGLE_ANALYTICS_ID=""
